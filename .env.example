# Base de datos MySQL (Prisma)
DATABASE_URL=                 # Connection string de MySQL (Hostinger u otro host)
# NextAuth v5 — Autenticación
NEXTAUTH_SECRET=              # Genera con: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=                  # Mismo valor que NEXTAUTH_SECRET
AUTH_URL=http://localhost:3000

# Anthropic — IA (AI Insights, Social Creator)
ANTHROPIC_API_KEY=            # Clave de https://console.anthropic.com

# Google Maps — Scrapper de leads geolocalizado
GOOGLE_MAPS_API_KEY=          # Clave de https://console.cloud.google.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=  # Misma clave (para embeds de mapa en el frontend)

# Email (SMTP) — Notificaciones y envío de presupuestos
SMTP_HOST=                    # Ej: smtp.hostinger.com
SMTP_PORT=587                 # 587 para STARTTLS, 465 para SSL
SMTP_SECURE=false             # true si el puerto es 465
SMTP_USER=                    # Email del remitente
SMTP_PASS=                    # Contraseña del email
SMTP_FROM=                    # Email que aparece como remitente

# WhatsApp — Enlace en emails de presupuestos
WHATSAPP_DEFAULT_NUMBER=      # Número de WhatsApp fallback en formato internacional sin + (ej: 5491112345678)

# Correo por-operador (IMAP + SMTP, casillas reales de Hostinger) — módulo /mail
MAIL_IMAP_HOST=               # Ej: imap.hostinger.com
MAIL_IMAP_PORT=993            # Puerto IMAP sobre SSL
MAIL_SMTP_HOST=               # Ej: smtp.hostinger.com (puede ser igual a SMTP_HOST)
MAIL_SMTP_PORT=465            # 465 SSL, 587 STARTTLS
MAIL_SMTP_SECURE=true         # true si el puerto es 465
MAIL_BACKUP_ADDRESS=          # Casilla de auditoría. Recibe copia oculta (BCC) de todo el correo saliente
                              # de /mail Y TAMBIÉN la copia visible (CC) que ve el destinatario.
                              # Sin esta variable el envío desde /mail se bloquea a propósito.
MAIL_CREDENTIALS_KEY=         # Clave AES-256 hex de 64 caracteres para cifrar contraseñas de casillas. Genera con: openssl rand -hex 32
MAIL_POLL_INTERVAL_MS=120000  # Cada cuánto se revisan las casillas por IMAP (ms). Opcional, default 120000
MAIL_POLLING_DISABLED=false   # Poné "true" para desactivar el poller (ej. en un segundo proceso/réplica)

# Logging — Nivel de log de Pino
LOG_LEVEL=info                # Opciones: fatal, error, warn, info, debug, trace

# Seed — Contraseñas iniciales (prisma db seed)
SEED_ADMIN_PASSWORD=          # Password del admin. Si no se define, se genera una aleatoria
SEED_OPERATOR_PASSWORD=       # Password del operador. Si no se define, se genera una aleatoria

# API pública de garantías — CORS para sitios externos (talleres, web de activación)
WARRANTY_PUBLIC_CORS_ORIGIN=  # Origin permitido (ej: https://garantias.tudominio.com). Si no se define, permite cualquier origen (*)

# API móvil (/api/mobile/v1) — usada por la app de ventas pos-movil
MOBILE_API_JWT_SECRET=        # Secreto para firmar los tokens de la app móvil. Genera con: openssl rand -base64 32
MOBILE_APP_CORS_ORIGIN=       # Origin permitido (ej: https://ventas.tudominio.com). Si no se define, permite cualquier origen (*)
