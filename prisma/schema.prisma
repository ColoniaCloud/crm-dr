  /// Content-ID de una imagen incrustada (`cid:`), sin los <>. Null si es un
  /// adjunto normal.
  contentId   String?
  isInline    Boolean   @default(false)
  /// Ruta relativa dentro de MAIL_ATTACHMENT_DIR. Queda en null cuando el
  /// archivo se purga por antigüedad: la fila sobrevive para que el mail siga
  /// mostrando que tenía un adjunto en vez de romperse.
  storageKey  String?   @db.Text
  checksum    String?
  purgedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([emailId])
  @@map("email_attachments")
}

// ─── Auditoría de operadores ──────────────────────────────────────────────────

model OperatorAuditLog {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id])
