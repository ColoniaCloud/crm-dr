// ─── Sistema de Garantías Digitales ──────────────────────────────────────────

enum WarrantyRollStatus {
  IN_STOCK
  SOLD
  IN_USE
  EXHAUSTED
  VOIDED
}

// Custodia física de un rollo mientras sigue siendo stock de la empresa
// (eje independiente del WarrantyRollStatus, que es el estado de garantía).
// DEPOSITO y LOCAL son singleton (una sola fila cada uno); PUNTO_REVENTA puede
// tener varias filas, cada una atada a un Contact (el instalador en cuyo
// taller vive el stock consignado — ver Location.contactId).
enum LocationType {
  DEPOSITO
  LOCAL
  PUNTO_REVENTA
}

model Location {
  id        String       @id @default(cuid())
  type      LocationType
  name      String
  // Solo para PUNTO_REVENTA: a qué instalador (Contact tipo CLIENT) pertenece
  // el taller donde vive este stock consignado. DEPOSITO/LOCAL lo dejan null.
  contactId String?
  contact   Contact?     @relation(fields: [contactId], references: [id])
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  rolls      WarrantyRoll[]
  eventsFrom WarrantyRollLocationEvent[] @relation("LocationEventFrom")
  eventsTo   WarrantyRollLocationEvent[] @relation("LocationEventTo")

  @@map("locations")
}

/// Log de traslados de un rollo entre ubicaciones (Depósito/Local/Punto de
/// Reventa). Existe mientras el rollo sigue IN_STOCK — una vez vendido, su
/// "ubicación" pasa a ser la venta/Contact, no esto (ver WarrantyRoll.currentLocationId).
model WarrantyRollLocationEvent {
  id             String       @id @default(cuid())
  rollId         String
  roll           WarrantyRoll @relation(fields: [rollId], references: [id], onDelete: Cascade)
  fromLocationId String?
  fromLocation   Location?    @relation("LocationEventFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location     @relation("LocationEventTo", fields: [toLocationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([rollId])
  @@map("warranty_roll_location_events")
}

enum WarrantyInstallationStatus {
  PENDING
  ACTIVE
  EXPIRED
  VOIDED
}

enum AssetType {
  VEHICLE
  WINDOW
  BUILDING
  OTHER
}

model WarrantyConfig {
  id                    String   @id @default(cuid())
  productId             String   @unique
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warrantyEnabled       Boolean  @default(true)
  rollWarrantyMonths    Int      @default(24)
  installWarrantyMonths Int      @default(12)
  maxInstallations      Int      @default(15)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("warranty_configs")
}

model WarrantyLot {
  id              String         @id @default(cuid())
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  lotNumber       String         @unique
  quantity        Int
  receivedAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())

  rolls WarrantyRoll[]

  @@map("warranty_lots")
}

model WarrantyRoll {
  id                String             @id @default(cuid())
  lotId             String
  lot               WarrantyLot        @relation(fields: [lotId], references: [id], onDelete: Cascade)
  productId         String
  product           Product            @relation(fields: [productId], references: [id])
  saleItemId        String?            @unique
  saleItem          SaleItem?          @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  unitId            String?            @unique
  unit              ProductUnit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  fullRollCode      String             @unique
  status            WarrantyRollStatus @default(IN_STOCK)
  // Custodia física mientras el rollo es IN_STOCK (Depósito/Local/Punto de
  // Reventa).
  //
  // OJO: **no** se limpia al vender, aunque este comentario decía lo contrario
  // hasta septiembre 2026. linkRollToSaleItem() la deja como está a propósito,
  // para que releaseRollForSaleItem() (venta borrada o revertida) pueda
  // devolver el rollo exactamente a donde estaba físicamente. Una vez vendido,
  // "de quién es" se responde por saleItem.sale.contactId; este campo sigue
  // diciendo dónde estaba, que es otra cosa.
  //
  // Consecuencia práctica: en un rollo SOLD este campo puede apuntar al Punto
  // de Reventa de OTRO instalador. Por eso NO sale en la API del portal —
  // ver PORTAL_ROLL_SELECT en src/lib/client-portal.ts.
  currentLocationId String?
  currentLocation   Location?          @relation(fields: [currentLocationId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  installations  WarrantyInstallation[]
  locationEvents WarrantyRollLocationEvent[]
  // Consumo declarado desde el taller de un instalador. Sumar
  // squareMetersUsed por acá es lo que da los m² que quedan en el rollo.
  workOrderItems WorkOrderItem[]

  @@map("warranty_rolls")
}

model WarrantyInstallation {
  id                 String                     @id @default(cuid())
  rollId             String
  roll               WarrantyRoll               @relation(fields: [rollId], references: [id], onDelete: Cascade)
  installationNumber Int
  installationCode   String                     @unique
  // Sin @default(cuid()): el token ES la capacidad completa sobre la garantía y
  // cuid es secuencial-ish (timestamp + contador), así que se genera en código
  // con randomBytes(32) — ver newActivationToken() en src/lib/warranty.ts.
  // Los tokens cuid ya emitidos siguen siendo válidos.
  activationToken    String                     @unique
  status             WarrantyInstallationStatus @default(PENDING)
  assetType          AssetType?
  assetDescription   String?                    @db.Text
  installerName      String?
  clientName         String?
  clientEmail        String?
  clientPhone        String?
  clientDni          String?
  installedAt        DateTime?
  activatedAt        DateTime?
  expiresAt          DateTime?
  notes              String?                    @db.Text
  portalPasswordHash String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  claims    WarrantyClaim[]
  // La OT del taller que generó esta instalación, si vino por ahí. Opcional en
  // los dos sentidos: la cadena de garantías es de Kristall y existía antes que
  // el módulo de taller.
  workOrder WorkOrder?

  @@unique([rollId, installationNumber])
  @@map("warranty_installations")
}

model WarrantyClaim {
  id              String               @id @default(cuid())
  installationId  String
  installation    WarrantyInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  status          WarrantyClaimStatus  @default(OPEN)
  description     String               @db.Text
  reporterName    String
  reporterEmail   String
  reporterPhone   String?
  channel         String // INTERNAL | PUBLIC_API
  assignedToId    String?
  assignedTo      User?                @relation(fields: [assignedToId], references: [id])
  resolutionNotes String?              @db.Text
  resolvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("warranty_claims")
}

enum WarrantyClaimStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

model WarrantyApiClient {
  id         String    @id @default(cuid())
  name       String
  apiKeyHash String    @unique
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@map("warranty_api_clients")
}

// ─── Portal de clientes — API server-to-server para el sitio externo ────────

model PortalApiClient {
  id         String    @id @default(cuid())
  name       String
  apiKeyHash String    @unique
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@map("portal_api_clients")
}

model ClientPortalAccount {
  id                String            @id @default(cuid())
  contactId         String            @unique
  contact           Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  email             String            @unique
  // Null mientras la cuenta esté **invitada pero sin activar**: el operador
  // mandó el mail y el Cliente todavía no eligió su contraseña. Antes era
  // obligatorio, y eso forzaba a que el operador le inventara una contraseña
  // para poder dejar la cuenta creada — justo lo que la invitación evita.
  //
  // Con null, la cuenta NO puede iniciar sesión: el login rechaza antes de
  // comparar nada, y los porteros del portal la tratan como no activada.
  passwordHash      String?
  // Kill switch del admin. Distinto de accessLevel: `enabled: false` bloquea
  // todo el portal; accessLevel solo decide cuánto ve adentro.
  enabled           Boolean           @default(true)
  // BASIC lo obtiene cualquier CLIENT que active su cuenta. INSTALLER lo habilita
  // a mano un operador — desde la ficha, o al mandar la invitación, y en ese
  // caso el Cliente ya activa directamente con el nivel puesto.
  accessLevel       PortalAccessLevel @default(BASIC)
  // Cuándo el Cliente eligió su contraseña. Es lo que distingue "invitada" de
  // "activa": junto con passwordHash, las dos caras del mismo hecho.
  activatedAt       DateTime?
  // WhatsApp que el cliente confirmó o cargó en el portal. NO pisa
  // Contact.whatsapp: si difieren, se le avisa al operador para que decida cuál
  // vale. Ver getWhatsappMismatch() del lado del CRM.
  whatsapp          String?
  whatsappUpdatedAt DateTime?
  // Reservado para el SSO de Google. El flujo está diferido a una fase
  // posterior; la columna se agrega ahora para no volver a migrar.
  // OJO: falta el @unique a propósito. Agregarlo acá hace que `db push` pida
  // --accept-data-loss (falso positivo suyo al crear un índice único junto con
  // la columna). Va junto con el flujo de SSO, que es cuando empieza a hacer falta.
  googleId          String?
  lastLoginAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tokens PortalAccessToken[]

  @@map("client_portal_accounts")
}

/// Token de un solo uso para activar la cuenta o recuperar la contraseña.
/// Se guarda hasheado, igual que las api keys — el valor en claro solo viaja
/// en el mail y nunca queda en la base.
model PortalAccessToken {
  id          String               @id @default(cuid())
  // Siempre presente: es el ancla. En una ACTIVATION la cuenta todavía no
  // existe, así que accountId va en null hasta que el cliente elige contraseña.
  contactId   String
  contact     Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  accountId   String?
  account     ClientPortalAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash   String               @unique
  purpose     PortalTokenPurpose
  // Email al que se envió, congelado. Si después cambia el email del contacto,
  // el token viejo deja de servir en lugar de habilitar una casilla distinta.
  sentToEmail String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime             @default(now())

  @@index([contactId, purpose])
  @@index([expiresAt])
  @@map("portal_access_tokens")
}

model PortalNotification {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String   @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([contactId, read])
  @@map("portal_notifications")
}

// ─── Cuenta corriente: plan de cuotas, imputación y ajustes ──────────────────
//
// El plan es OPCIONAL. Una venta puede cobrarse de tres formas y las tres son
// válidas para el modelo:
//   1. Contado          — un Payment que cubre el total, sin plan.
//   2. Pagos libres     — varios Payment sueltos, sin plan ni vencimientos.
//                         Es lo que ya viene pasando (10 de 44 ventas al
//                         2026-08, una con 4 pagos).
//   3. Cuotas formales  — un PaymentPlan con N cuotas y sus vencimientos.
//
// Se puede pasar de (2) a (3) sin anular nada: al crear el plan, los pagos que
// ya existían se imputan hacia atrás con la regla FIFO (cuota más vieja
// primero). Y si el plan se cancela, la venta vuelve a comportarse como (2) con
// el saldo intacto.

/// Acuerdo de pago en cuotas sobre una venta. Como máximo uno por venta.
model PaymentPlan {
  id               String               @id @default(cuid())
  saleId           String               @unique
  sale             Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  installmentCount Int
  frequency        PaymentPlanFrequency @default(MONTHLY)
  firstDueDate     DateTime
  // Total a pagar en cuotas. Hoy siempre == sale.total porque no se cobra
  // recargo por financiar (auditado: cero menciones a interés en 44 ventas).
  // Existe como columna propia para que el día que se cobre no haya que migrar.
  financedTotal    Decimal              @db.Decimal(10, 2)
  interestRate     Decimal?             @db.Decimal(5, 2)
  status           PaymentPlanStatus    @default(ACTIVE)
  notes            String?              @db.Text
  createdById      String
  createdBy        User                 @relation("PaymentPlanCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  installments PaymentInstallment[]

  @@map("payment_plans")
}

/// Una cuota del plan: cuánto y para cuándo.
///
/// No tiene columna de estado a propósito. Si "pagada" / "parcial" / "vencida"
/// fueran campos guardados, alguien tendría que acordarse de actualizarlos y
/// terminarían desfasados — el mismo malentendido que generó Sale.status.
/// Se calculan al leer, desde las allocations y la fecha.
model PaymentInstallment {
  id        String      @id @default(cuid())
  planId    String
  plan      PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  number    Int
  dueDate   DateTime
  amount    Decimal     @db.Decimal(10, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  allocations PaymentAllocation[]

  @@unique([planId, number])
  @@index([dueDate])
  @@map("payment_installments")
}

/// Imputación de un pago a una cuota, con el monto aplicado.
///
/// Es N:N con monto y no una simple referencia porque un pago puede cubrir una
/// cuota y media, y una cuota puede cubrirse con tres pagos parciales. Sin el
/// monto habría que inventar reglas frágiles para repartirlo.
model PaymentAllocation {
  id            String             @id @default(cuid())
  paymentId     String
  payment       Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installmentId String
  installment   PaymentInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  amount        Decimal            @db.Decimal(10, 2)
  createdAt     DateTime           @default(now())

  @@unique([paymentId, installmentId])
  @@index([installmentId])
  @@map("payment_allocations")
}

/// Movimiento de cuenta corriente que no viene de una venta ni de un pago:
/// nota de crédito, devolución, condonación, o saldo anterior al CRM.
///
/// No hay saldos previos a abril 2026 (confirmado con el cliente), así que
/// OPENING_BALANCE queda disponible pero sin uso inmediato.
model AccountAdjustment {
  id          String                @id @default(cuid())
  contactId   String
  contact     Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type        AccountAdjustmentType
  // Con signo: positivo aumenta la deuda del cliente, negativo la reduce.
  amount      Decimal               @db.Decimal(10, 2)
  currency    Currency              @default(ARS)
  description String                @db.Text
  effectiveAt DateTime              @default(now())
  createdById String
  createdBy   User                  @relation("AccountAdjustmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime              @default(now())

  @@index([contactId, effectiveAt])
  @@map("account_adjustments")
}

// ─── Mi Taller — gestión del taller del instalador ───────────────────────────
//
// Módulo del Panel de Cliente, nivel INSTALLER (plan completo en
// TALLER-INSTALADOR.md, en la raíz del workspace). Fase 1: solo el modelo.
//
// **Todo lo que hay acá es de UN instalador y de nadie más.** Cada fila cuelga
// de un `contactId`, directo (WorkshopClient, WorkOrder, WorkshopSettings) o
// por relación (WorkshopAsset vía su cliente; WorkOrderItem y
// WorkOrderPayment vía su OT). La regla que hay que sostener en cada endpoint:
// un id que viene de la URL **no autoriza nada** — siempre se filtra además por
// el `contactId` de la sesión firmada, incluso en los GET. El patrón es el
// mismo que ya usa src/lib/client-portal.ts para el stock:
// `where: { id, workshopClient: { contactId } }`.
//
// Por eso WorkshopAsset NO repite `contactId`: un campo denormalizado se puede
// desincronizar del dueño real, y filtrar por la relación no se puede olvidar
// sin que el query directamente no compile.
//
// Es aditivo: no cambia ni una columna existente. La cadena de garantías de
// Kristall (WarrantyRoll → WarrantyInstallation → WarrantyClaim) sigue
// funcionando igual sin este módulo — la OT apunta a la instalación y no al
// revés, justamente para que siga siendo así.

/// Ciclo de vida de una OT. Los nombres van en español porque son los que se
/// publican en el contrato de la API y los que usa la UI; hay precedente en
/// LocationType (DEPOSITO / LOCAL / PUNTO_REVENTA).
///
/// PRESUPUESTADA → AGENDADA → EN_PROCESO → TERMINADA → ENTREGADA
/// (cualquiera de los cuatro primeros puede ir a CANCELADA)
///
/// El estado NO se cambia con un PATCH suelto: hay un endpoint de transición
/// porque entrar en TERMINADA dispara efectos (descontar m², generar la
/// WarrantyInstallation, mandar el mail) que tienen que ser transaccionales.
enum WorkOrderStatus {
  PRESUPUESTADA
  AGENDADA
  EN_PROCESO
  TERMINADA
  ENTREGADA
  CANCELADA
}

/// El cliente final del instalador. **No es un Contact del CRM**: el equipo de
/// Kristall no vende ni le hace seguimiento a esta persona, y mezclarlo con
/// Contact llenaría el CRM de miles de filas que no son leads ni clientes de
/// Kristall.
///
/// `name` es un solo campo, no firstName/lastName, para que entre tal cual en
/// WarrantyInstallation.clientName cuando la OT pase a TERMINADA. Partirlo acá
/// obligaría a concatenar allá y a decidir qué hacer con "Transporte del Sur SRL".
model WorkshopClient {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  name      String
  /// Hace falta para mandarle el mail de garantía al pasar a TERMINADA. Es
  /// opcional porque a un cliente de mostrador no siempre se le pide.
  email     String?
  phone     String?
  dni       String?
  address   String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets     WorkshopAsset[]
  workOrders WorkOrder[]

  @@index([contactId, name])
  @@map("workshop_clients")
}

/// El vehículo o la superficie sobre la que se trabaja. Colgar de
/// WorkshopClient (y no de la OT) es lo que habilita el historial: "a este auto
/// ya le pusimos KRYPTON 05 en 2025".
///
/// Reusa el enum AssetType de la cadena de garantías, así que al pasar a
/// TERMINADA el valor va tal cual a WarrantyInstallation.assetType.
model WorkshopAsset {
  id               String         @id @default(cuid())
  workshopClientId String
  workshopClient   WorkshopClient @relation(fields: [workshopClientId], references: [id], onDelete: Cascade)
  type             AssetType      @default(VEHICLE)
  /// Patente, número de unidad, o cómo lo llama el instalador ("vidriera del
  /// frente"). No es único: dos clientes distintos pueden traer la misma chapa
  /// mal tipeada, y bloquear eso rompería el alta rápida sin ganar nada.
  identifier       String?
  brand            String?
  model            String?
  year             Int?
  color            String?
  notes            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workOrders WorkOrder[]

  @@index([workshopClientId])
  @@map("workshop_assets")
}

/// La Orden de Trabajo: la entidad central del módulo. Ata cliente final +
/// vehículo + qué lámina se puso + cuándo + cuánto material salió + cuánto se
/// cobró + qué garantía generó.
model WorkOrder {
  id          String  @id @default(cuid())
  contactId   String
  contact     Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// Secuencial **por instalador**: el tipo quiere decir "la OT 47", no "la
  /// 12844". Lo entrega WorkshopSettings.nextOrderNumber con un incremento
  /// atómico dentro de la transacción del alta; el @@unique de abajo es la red
  /// que atrapa cualquier carrera que se escape.
  orderNumber Int

  workshopClientId String
  workshopClient   WorkshopClient @relation(fields: [workshopClientId], references: [id], onDelete: Cascade)
  /// Opcional: un presupuesto por teléfono se carga sin patente. Pasar a
  /// TERMINADA sí lo exige, porque la garantía necesita assetType y
  /// assetDescription — eso se valida en el servidor, no acá.
  ///
  /// SetNull y no Restrict a propósito: si fuera Restrict, borrar un Contact
  /// (que cascadea a sus clientes finales y a los vehículos de estos) chocaría
  /// contra las OT y fallaría. Que la API impida borrar un vehículo con OT es
  /// una regla de aplicación, no de la base.
  assetId          String?
  asset            WorkshopAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  status WorkOrderStatus @default(PRESUPUESTADA)

  /// Cuándo se le dio turno. Es lo que dibuja la agenda.
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  /// Lo cotizado y lo que terminó saliendo. Los dos, porque la diferencia entre
  /// ambos es justamente lo que el instalador quiere mirar a fin de mes.
  priceQuoted Decimal? @db.Decimal(10, 2)
  priceFinal  Decimal? @db.Decimal(10, 2)
  currency    Currency @default(ARS)

  notes String? @db.Text

  /// La instalación de garantía que generó esta OT al pasar a TERMINADA.
  /// La flecha va en este sentido y no al revés: una WarrantyInstallation puede
  /// existir sin OT (todas las que ya hay), y una OT puede terminar sin
  /// garantía (un pulido, sacar una lámina vieja).
  warrantyInstallationId String?               @unique
  warrantyInstallation   WarrantyInstallation? @relation(fields: [warrantyInstallationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    WorkOrderItem[]
  payments WorkOrderPayment[]

  @@unique([contactId, orderNumber])
  @@index([contactId, status])
  @@index([contactId, scheduledAt])
  @@index([workshopClientId])
  @@map("work_orders")
}

/// Una línea de trabajo dentro de la OT: parabrisas, laterales, luneta.
/// Acá se declara el consumo de material.
model WorkOrderItem {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  /// Lo que se hizo, en las palabras del instalador. Es lo que se ve en la
  /// ficha de trabajo al lado del auto.
  description String

  /// Qué producto se usó. Opcional porque en un presupuesto todavía puede no
  /// estar decidido, y porque hay trabajos que no llevan lámina.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  /// De qué rollo salió. Opcional por lo mismo: recién se sabe cuando se corta.
  /// **Tiene que ser un rollo del propio instalador** — se valida en el
  /// servidor contra el contactId de la sesión, la base no lo puede expresar.
  /// Si hay rollId y productId, tienen que coincidir con roll.productId (misma
  /// validación de servidor).
  rollId String?
  roll   WarrantyRoll? @relation(fields: [rollId], references: [id], onDelete: SetNull)

  /// Metros CUADRADOS consumidos del rollo. El plan lo llamaba `metersUsed`,
  /// pero lo que se resta son m², y un nombre que miente sobre la unidad se
  /// paga caro cuando alguien calcula el sobrante.
  ///
  /// No se guarda un "restante" en el rollo: lo que queda es
  /// (Product.width × Product.length) − Σ(squareMetersUsed) para ese rollId.
  /// Por eso el índice de abajo. Si algún día eso se pone lento, ahí se
  /// denormaliza — con la evidencia a la vista, no antes.
  squareMetersUsed Decimal? @db.Decimal(10, 2)

  /// Lo que el instalador le cobra a SU cliente por esta línea.
  price Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderId])
  @@index([rollId])
  @@map("work_order_items")
}

/// Lo que el cliente final le pagó AL INSTALADOR.
///
/// **Nada de esto toca la cuenta corriente del CRM.** El saldo que Kristall le
/// lleva al instalador se calcula en src/lib/account.ts desde Sale, Payment y
/// AccountAdjustment, y esta tabla no entra ahí ni tiene que entrar: es plata
/// entre el instalador y su cliente, en la que Kristall no es parte. Son dos
/// libros distintos que da la casualidad que viven en la misma base.
model WorkOrderPayment {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(10, 2)
  currency    Currency  @default(ARS)
  /// Texto libre, igual que en Payment.method del CRM: efectivo, transferencia,
  /// MercadoPago, lo que use cada taller.
  method      String?
  reference   String?
  notes       String?   @db.Text
  paidAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
  @@map("work_order_payments")
}

/// Configuración del taller, una fila por instalador.
///
/// Además de la config, es donde vive el contador de OT: se pide con un
/// `increment` atómico dentro de la transacción del alta, que es seguro contra
/// carreras — un `max(orderNumber) + 1` no lo es.
model WorkshopSettings {
  id        String  @id @default(cuid())
  contactId String  @unique
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Próximo número de OT a entregar. Ver el comentario de WorkOrder.orderNumber.
  nextOrderNumber Int @default(1)

  /// Cómo se llama el taller en el mail que recibe el cliente final. Si es
  /// null se usa la razón social del Contact, y si tampoco hay, su nombre.
  workshopName String?

  /// Si al pasar a TERMINADA se manda solo el mail de garantía al cliente
  /// final. Con false, la OT genera igual la instalación y el instalador
  /// comparte el link cuando quiere.
  autoSendWarrantyEmail Boolean @default(true)

  /// Horarios de atención, para que la agenda sepa qué franjas dibujar.
  /// "HH:MM" en la hora local del taller, no DateTime: es una hora del día que
  /// se repite, no un instante, y meterla en un DateTime obliga a inventar una
  /// fecha y a pelear con la zona horaria en cada lectura.
  openingTime String? @default("09:00")
  closingTime String? @default("18:00")
  /// Días laborables como números ISO separados por coma (1 = lunes).
  workingDays String? @default("1,2,3,4,5")

  defaultCurrency Currency @default(ARS)

  /// Logo del taller, en base64 (`iVBORw0…`, sin el prefijo `data:`).
  ///
  /// Se guarda en la base como ya se guardan las imágenes de producto, pero
  /// **no se sirve como data URI**: los clientes de correo bloquean las
  /// imágenes embebidas así, y este logo tiene que verse en el mail de garantía
  /// que recibe el usuario final. Por eso sale por
  /// `GET /api/public/workshop/[contactId]/logo`, que devuelve los bytes con su
  /// tipo, y en el HTML entra como una URL normal.
  logo         String? @db.LongText
  /// `image/png`, `image/jpeg`, `image/webp`. Hace falta para servirlo bien.
  logoMimeType String?
  /// Clave opaca con la que se sirve el logo públicamente.
  ///
  /// Existe para que la URL del logo **no lleve el `contactId`**. No es que ese
  /// id sea explotable —la API del portal exige la api key y nunca acepta un
  /// contactId que venga del request—, pero un id interno en una URL que va en
  /// un mail a cualquier usuario final es una filtración gratis. Mismo criterio
  /// que se tomó con `activationToken` en F0-23: si va a estar a la vista, que
  /// sea un valor aleatorio y no un identificador del sistema.
  logoSlug     String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workshop_settings")
}
