  enabled             Boolean   @default(true)
  imapUidValidity     Int?
  imapLastUid         Int       @default(0)
  lastPolledAt        DateTime?
  lastPollError       String?   @db.Text
  consecutiveFailures Int       @default(0)
  pausedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("mail_accounts")
}

model Email {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation("MailboxOwner", fields: [userId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?       @relation("ContactEmails", fields: [contactId], references: [id], onDelete: SetNull)
  direction    EmailDirection
  status       EmailStatus
  subject      String?        @db.Text
  bodyHtml     String?        @db.LongText
  bodyText     String?        @db.LongText
  fromAddress  String
  toAddress    String         @db.Text
  ccAddress    String?        @db.Text
  messageId    String
  inReplyTo    String?
  imapUid      Int?
  errorMessage String?        @db.Text
  read         Boolean        @default(false)
  sentAt       DateTime?
  receivedAt   DateTime?
