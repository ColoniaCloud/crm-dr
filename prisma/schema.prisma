  // Denormalizado para pintar el clip en el listado sin hacer join: la bandeja
  // trae 50 mails y solo necesita saber si tienen adjuntos, no cuáles.
  hasAttachments Boolean @default(false)
  /// Ruta del .eml original en disco (ver lib/mail-attachments.ts). Permite
  /// "ver original" y reprocesar un mail sin volver al servidor IMAP.
